{
  "$schema": "https://design-tokens.github.io/format/tokens.schema.json",
  "brand": {
    "$description": "Clearco brand color system",
    "primary": {
      "$description": "Primary brand color with tints and shades",
      "50": { "$value": "#e6f0ff", "$type": "color", "$description": "Lightest tint" },
      "100": { "$value": "#b3d1ff", "$type": "color", "$description": "Very light tint" },
      "200": { "$value": "#80b3ff", "$type": "color", "$description": "Light tint" },
      "300": { "$value": "#4d94ff", "$type": "color", "$description": "Medium light tint" },
      "400": { "$value": "#1a75ff", "$type": "color", "$description": "Medium tint" },
      "500": { "$value": "#0066cc", "$type": "color", "$description": "Base primary color" },
      "600": { "$value": "#0052a3", "$type": "color", "$description": "Medium shade" },
      "700": { "$value": "#003d7a", "$type": "color", "$description": "Dark shade" },
      "800": { "$value": "#002952", "$type": "color", "$description": "Very dark shade" },
      "900": { "$value": "#001429", "$type": "color", "$description": "Darkest shade" }
    },
    "secondary": {
      "$description": "Secondary brand color with tints and shades",
      "50": { "$value": "#f8f0fc", "$type": "color", "$description": "Lightest tint" },
      "100": { "$value": "#f3d9fa", "$type": "color", "$description": "Very light tint" },
      "200": { "$value": "#eebefa", "$type": "color", "$description": "Light tint" },
      "300": { "$value": "#e599f7", "$type": "color", "$description": "Medium light tint" },
      "400": { "$value": "#da77f2", "$type": "color", "$description": "Medium tint" },
      "500": { "$value": "#cc5de8", "$type": "color", "$description": "Base secondary color" },
      "600": { "$value": "#be4bdb", "$type": "color", "$description": "Medium shade" },
      "700": { "$value": "#ae3ec9", "$type": "color", "$description": "Dark shade" },
      "800": { "$value": "#9c36b5", "$type": "color", "$description": "Very dark shade" },
      "900": { "$value": "#862e9c", "$type": "color", "$description": "Darkest shade" }
    },
    "accent": {
      "$description": "Accent color with tints and shades",
      "50": { "$value": "#e9fbfa", "$type": "color", "$description": "Lightest tint" },
      "100": { "$value": "#c3f4f1", "$type": "color", "$description": "Very light tint" },
      "200": { "$value": "#9dede8", "$type": "color", "$description": "Light tint" },
      "300": { "$value": "#77e6df", "$type": "color", "$description": "Medium light tint" },
      "400": { "$value": "#51dfd6", "$type": "color", "$description": "Medium tint" },
      "500": { "$value": "#4ecdc4", "$type": "color", "$description": "Base accent color" },
      "600": { "$value": "#3ea49d", "$type": "color", "$description": "Medium shade" },
      "700": { "$value": "#2f7b76", "$type": "color", "$description": "Dark shade" },
      "800": { "$value": "#1f524e", "$type": "color", "$description": "Very dark shade" },
      "900": { "$value": "#102927", "$type": "color", "$description": "Darkest shade" }
    },
    "neutral": {
      "$description": "Brand-tuned neutral scale",
      "50": { "$value": "#f8f9fa", "$type": "color", "$description": "Lightest neutral" },
      "100": { "$value": "#f1f3f5", "$type": "color", "$description": "Very light neutral" },
      "200": { "$value": "#e9ecef", "$type": "color", "$description": "Light neutral" },
      "300": { "$value": "#dee2e6", "$type": "color", "$description": "Medium light neutral" },
      "400": { "$value": "#ced4da", "$type": "color", "$description": "Medium neutral" },
      "500": { "$value": "#adb5bd", "$type": "color", "$description": "Base neutral" },
      "600": { "$value": "#6c757d", "$type": "color", "$description": "Medium dark neutral" },
      "700": { "$value": "#495057", "$type": "color", "$description": "Dark neutral" },
      "800": { "$value": "#343a40", "$type": "color", "$description": "Very dark neutral" },
      "900": { "$value": "#212529", "$type": "color", "$description": "Darkest neutral" }
    },
    "semantic": {
      "$description": "Semantic colors for Clearco brand",
      "success": {
        "$value": "{brandBase.semantic.state.success.default}",
        "$type": "color",
        "$description": "Success state color"
      },
      "warning": {
        "$value": "{brandBase.semantic.state.warning.default}",
        "$type": "color",
        "$description": "Warning state color"
      },
      "error": {
        "$value": "{brandBase.semantic.state.error.default}",
        "$type": "color",
        "$description": "Error state color"
      },
      "info": {
        "$value": "{brand.primary.500}",
        "$type": "color",
        "$description": "Info state color"
      }
    }
  }
}